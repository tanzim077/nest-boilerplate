// This file has your datasource and generator
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model Auth {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email])
}
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  age       Int?
  createdAt DateTime @default(now())

  auth Auth?
}
